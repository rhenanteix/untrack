generator client {
  provider = "prisma-client-js"
}


enum SmartPageStatus {
  draft
  published
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalyticsEvent {
  id               String          @id @default(cuid())
  name             String
  occurredAt       DateTime        @default(now())
  metadata         Json
  workspaceId      String?
  smartPageId      String?
  smartPageBlockId String?
  day              DateTime?       @db.Date
  visitorHash      String?         @db.VarChar(64)
  referrer         String?         @db.VarChar(253)
  device           String?         @db.VarChar(20)
  workspace        Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  smartPage        SmartPage?      @relation(fields: [smartPageId], references: [id], onDelete: Cascade)
  smartPageBlock   SmartPageBlock? @relation(fields: [smartPageBlockId], references: [id], onDelete: Cascade)

  @@index([name, occurredAt])
  @@index([smartPageId, day])
  @@index([smartPageBlockId, day])
  @@index([smartPageId, visitorHash])
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  links         ShortLink[]
  history       LinkHistory[]
  memberships   WorkspaceMember[]
  campaignsResponsible Campaign[]
  campaignApprovals CampaignApproval[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model SmartPage {
  id          String          @id @default(cuid())
  workspaceId String
  slug        String          @unique @db.VarChar(60)
  title       String          @db.VarChar(120)
  description String          @default("") @db.VarChar(500)
  avatarUrl   String?         @db.VarChar(4096)
  theme       Json            @default("{}")
  socialLinks Json            @default("[]")
  status      SmartPageStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocks      SmartPageBlock[]
  analyticsEvents AnalyticsEvent[]

  @@index([workspaceId, createdAt])
  @@index([status, publishedAt])
}

model SmartPageBlock {
  id               String     @id @default(cuid())
  smartPageId      String
  type             String     @db.VarChar(40)
  position         Int
  settings         Json
  visible          Boolean    @default(true)
  analyticsEnabled Boolean    @default(true)
  linkId           String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  smartPage        SmartPage  @relation(fields: [smartPageId], references: [id], onDelete: Cascade)
  link             ShortLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  analyticsEvents  AnalyticsEvent[]

  @@unique([smartPageId, position])
  @@index([smartPageId, position])
  @@index([linkId])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model ShortLink {
  id             String      @id @default(cuid())
  slug           String
  domainKey      String      @default("platform")
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expiresAt      DateTime?
  tags           String[]    @default([])
  folderId       String?
  folder         LinkFolder? @relation(fields: [folderId, workspaceId], references: [id, workspaceId])
  campaignId     String?
  campaign       Campaign?   @relation(fields: [campaignId, workspaceId], references: [id, workspaceId])
  distribution   String      @default("digital")
  qr             QrAsset?
  destinationUrl String      @db.VarChar(4096)
  title          String      @default("") @db.VarChar(120)
  description    String      @default("") @db.VarChar(500)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks         LinkClick[]
  smartPageBlocks SmartPageBlock[]

  @@unique([domainKey, slug])
  @@unique([id, workspaceId])

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
}

model LinkClick {
  id        String    @id @default(cuid())
  linkId    String
  link      ShortLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  day       DateTime  @db.Date
  referrer  String    @db.VarChar(253)
  device    String    @db.VarChar(20)

  @@index([linkId, createdAt])
  @@index([linkId, day])
}

model LinkHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalUrl String   @db.VarChar(4096)
  resultUrl   String   @db.VarChar(8192)
  kind        String   @db.VarChar(20)
  createdAt   DateTime @default(now())
  importKey   String?
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, importKey])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

enum Plan {
  free
  pro
  business
}

model Workspace {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  plan Plan @default(free)
  governance Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members WorkspaceMember[]
  clients Client[]
  campaigns Campaign[]
  usage WorkspaceUsage[]
  audits AuditLog[]
  links ShortLink[]
  history LinkHistory[]
  templates UtmTemplate[]
  utmLinks UtmLink[]
  folders LinkFolder[]
  domains CustomDomain[]
  qrs QrAsset[]
  channels CampaignChannel[]
  checklistItems CampaignChecklist[]
  approvals CampaignApproval[]
  monitorChecks CampaignMonitorCheck[]
  incidents CampaignIncident[]
  deliveries NotificationDelivery[]
  smartPages SmartPage[]
  analyticsEvents AnalyticsEvent[]
}

model WorkspaceMember {
  workspaceId String
  userId String
  role WorkspaceRole @default(viewer)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([workspaceId, userId])
  @@index([userId])
}

model WorkspaceUsage {
  workspaceId String
  resource String
  count Int @default(0)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([workspaceId, resource])
}

model AuditLog {
  id String @id @default(cuid())
  workspaceId String
  actorId String
  action String
  entityId String
  details Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model Client {
  id String @id @default(cuid())
  workspaceId String
  name String @db.VarChar(120)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  utmLinks UtmLink[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}

model Campaign {
  id String @id @default(cuid())
  workspaceId String
  name String @db.VarChar(120)
  description String? @db.VarChar(2000)
  clientId String?
  responsibleId String?
  objective String? @db.VarChar(1000)
  startDate DateTime?
  endDate DateTime?
  status String @default("draft") @db.VarChar(20)
  approvalStatus String? @db.VarChar(20)
  approvedAt DateTime?
  approvedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId, workspaceId], references: [id, workspaceId])
  responsible User? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  utmLinks UtmLink[]
  shortLinks ShortLink[]
  qrs QrAsset[]
  channels CampaignChannel[]
  checklistItems CampaignChecklist[]
  monitoringChecks CampaignMonitorCheck[]
  incidents CampaignIncident[]
  approvals CampaignApproval[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([responsibleId])
}

model CampaignChannel {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  name String @db.VarChar(120)
  type String @db.VarChar(40)
  utmSource String? @db.VarChar(120)
  utmMedium String? @db.VarChar(120)
  utmCampaign String? @db.VarChar(120)
  utmTerm String? @db.VarChar(120)
  utmContent String? @db.VarChar(120)
  destinationUrl String @db.VarChar(4096)
  shortLinkId String?
  qrId String?
  templateId String?
  monitorEnabled Boolean @default(false)
  monitorFrequencyMinutes Int @default(60)
  monitorPaused Boolean @default(false)
  alternativeDestinationUrl String? @db.VarChar(4096)
  autoRedirectOnIncident Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  monitorChecks CampaignMonitorCheck[]
  incidents CampaignIncident[]
  @@unique([id, workspaceId])
  @@index([workspaceId, campaignId])
  @@index([campaignId])
}

model CampaignChecklist {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  channelId String?
  category String @db.VarChar(60)
  label String @db.VarChar(200)
  status String @default("pending") @db.VarChar(20)
  severity String @default("warning") @db.VarChar(20)
  details String @db.VarChar(2000)
  checkedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([workspaceId, campaignId])
  @@index([campaignId, status])
}

model CampaignMonitorCheck {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  channelId String?
  url String @db.VarChar(4096)
  httpStatus Int?
  responseTimeMs Int?
  finalUrl String? @db.VarChar(4096)
  redirectChain Json
  connectionError String?
  certExpiresAt DateTime?
  certIssuer String? @db.VarChar(200)
  status String @default("unknown") @db.VarChar(20)
  checkedAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel CampaignChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([workspaceId, checkedAt])
  @@index([campaignId, checkedAt])
  @@index([channelId, checkedAt])
}

model CampaignIncident {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  channelId String?
  code String @db.VarChar(80)
  message String @db.VarChar(500)
  status String @default("open") @db.VarChar(20)
  severity String @default("warning") @db.VarChar(20)
  confirmed Boolean @default(false)
  dedupeKey String @db.VarChar(200)
  cooldownUntil DateTime?
  recoveredAt DateTime?
  metadata Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel CampaignChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  @@unique([id, workspaceId])
  @@index([workspaceId, dedupeKey, createdAt])
  @@index([campaignId, status])
  @@index([channelId, status])
}

model CampaignApproval {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  approverId String
  action String @db.VarChar(40)
  notes String @db.VarChar(1000)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approver User @relation(fields: [approverId], references: [id], onDelete: Cascade)
  @@index([workspaceId, campaignId])
  @@index([campaignId, createdAt])
}

model NotificationDelivery {
  id String @id @default(cuid())
  workspaceId String
  incidentId String?
  adapter String @db.VarChar(40)
  status String @default("pending") @db.VarChar(20)
  payload Json
  response Json?
  sentAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, incidentId])
  @@index([createdAt])
}

model LinkFolder {
  id String @id @default(cuid())
  workspaceId String
  name String @db.VarChar(120)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  links ShortLink[]
  @@unique([id, workspaceId])
  @@unique([workspaceId, name])
}

model CustomDomain {
  id String @id @default(cuid())
  workspaceId String
  hostname String @unique
  token String
  status String @default("pending_dns")
  verifiedAt DateTime?
  checkedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
}

model QrAsset {
  id String @id @default(cuid())
  workspaceId String
  name String @db.VarChar(120)
  mode String
  destinationUrl String @db.VarChar(8192)
  encodedUrl String @db.VarChar(8192)
  visual Json
  campaignId String?
  redirectId String? @unique
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId, workspaceId], references: [id, workspaceId])
  redirect ShortLink? @relation(fields: [redirectId], references: [id], onDelete: Restrict)
  @@index([workspaceId, createdAt])
}

model ClickOutbox {
  id String @id @default(cuid())
  linkId String
  createdAt DateTime @default(now())
  day DateTime @db.Date
  referrer String @db.VarChar(253)
  device String @db.VarChar(20)
  @@index([createdAt])
}

model UtmTemplate {
  id String @id @default(cuid())
  workspaceId String
  name String @db.VarChar(120)
  values Json
  favorite Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model UtmLink {
  id String @id @default(cuid())
  workspaceId String
  name String @db.VarChar(120)
  originalUrl String @db.VarChar(4096)
  resultUrl String @db.VarChar(8192)
  appliedValues Json
  governanceSnapshot Json
  templateId String?
  clientId String?
  campaignId String?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId, workspaceId], references: [id, workspaceId])
  campaign Campaign? @relation(fields: [campaignId, workspaceId], references: [id, workspaceId])
  @@index([workspaceId, createdAt])
}
