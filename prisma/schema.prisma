generator client {
  provider = "prisma-client-js"
}


enum SmartPageStatus {
  draft
  published
}

enum SmartPageFormStatus {
  active
  inactive
}

enum SmartCardStatus {
  draft
  published
  archived
}

enum SmartCardActionType {
  website
  whatsapp
  email
  phone
  calendar
  smartPage
  custom
}

enum SmartCardWalletProvider {
  apple
  google
}

enum SmartCardWalletPassStatus {
  pending_sync
  synced
  sync_failed
  revoked
}

enum AudienceContactStatus {
  new_contact
  interested
  qualified
  customer
  not_interested
}

enum ContactTemperature {
  cold
  warm
  hot
}

enum AudienceContactLifecycle {
  new
  engaged
  converted
}

enum AudienceEngagementLevel {
  low
  medium
  high
}

enum ProductStatus {
  draft
  active
  archived
}

enum ProductType {
  physical
  digital
  course
  booking
  session
  mentorship
  coaching
  bundle
  event
  subscription
}

enum ProjectStatus {
  active
  archived
}

enum ProjectResourceType {
  shortLink
  smartPage
  campaign
  utmLink
  qrAsset
  whatsappLink
}

enum WorkspaceResourceType {
  project
  shortLink
  smartPage
  campaign
  utmLink
  qrAsset
  whatsappLink
}

enum WhatsappLinkStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AnalyticsGoalType {
  LINK_CLICK
  WHATSAPP_CLICK
  FORM_SUBMIT
  LEAD_CREATED
  QR_SCAN
  PAGE_VIEW
  BUTTON_CLICK
}

enum AnalyticsGoalStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AnalyticsGoalScopeType {
  WORKSPACE
  CAMPAIGN
  ASSET
  ELEMENT
}

enum CollectionKind {
  manual
  smart
}

enum ProjectMemberRole {
  owner
  editor
  viewer
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalyticsEvent {
  id                String          @id @default(cuid())
  eventId           String          @unique @default(cuid())
  name              String          @db.VarChar(80)
  origin            String          @default("server") @db.VarChar(16)
  occurredAt       DateTime        @default(now())
  metadata         Json            @default("{}")
  workspaceId      String?
  userId           String?
  audienceContactId String?
  visitorId        String?
  sessionId        String?
  assetType        String?         @db.VarChar(40)
  assetId          String?         @db.VarChar(255)
  elementType      String?         @db.VarChar(40)
  elementId        String?         @db.VarChar(255)
  campaignId       String?         @db.VarChar(255)
  campaignAssetId  String?         @db.VarChar(255)
  goalId           String?
  path             String?         @db.VarChar(2048)
  destinationUrl   String?         @db.VarChar(4096)
  smartPageId      String?
  smartPageBlockId String?
  smartCardId      String?
  smartCardActionId String?
  day              DateTime?       @db.Date
  visitorHash      String?         @db.VarChar(64)
  referrer         String?         @db.VarChar(253)
  device           String?         @db.VarChar(20)
  source           String?         @db.VarChar(253)
  medium           String?         @db.VarChar(120)
  channel          String?         @db.VarChar(40)
  utmSource        String?         @db.VarChar(120)
  utmMedium        String?         @db.VarChar(120)
  utmCampaign      String?         @db.VarChar(120)
  utmContent       String?         @db.VarChar(120)
  utmTerm          String?         @db.VarChar(120)
  country          String?         @db.VarChar(2)
  region           String?         @db.VarChar(120)
  city             String?         @db.VarChar(120)
  timezone         String?         @db.VarChar(80)
  deviceType       String?         @db.VarChar(20)
  os               String?         @db.VarChar(20)
  browser          String?         @db.VarChar(20)
  isBot            Boolean         @default(false)
  botType          String?         @db.VarChar(20)
  isTest           Boolean         @default(false)
  workspace        Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  audienceContact  AudienceContact? @relation(fields: [audienceContactId], references: [id], onDelete: SetNull)
  visitor          AnalyticsVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  analyticsSession AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  smartPage        SmartPage?      @relation(fields: [smartPageId], references: [id], onDelete: Cascade)
  smartPageBlock   SmartPageBlock? @relation(fields: [smartPageBlockId], references: [id], onDelete: Cascade)
  smartCard        SmartCard?      @relation(fields: [smartCardId], references: [id], onDelete: Cascade)
  smartCardAction  SmartCardAction? @relation(fields: [smartCardActionId], references: [id], onDelete: SetNull)
  goal             AnalyticsGoal?  @relation("AnalyticsGoalCompletionEvents", fields: [goalId], references: [id], onDelete: SetNull)
  conversions      AnalyticsConversion[]

  @@index([name, occurredAt])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, name, occurredAt])
  @@index([workspaceId, isTest, occurredAt])
  @@index([assetId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([campaignAssetId, occurredAt])
  @@index([goalId, occurredAt])
  @@index([userId, occurredAt])
  @@index([audienceContactId, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([smartPageId, day])
  @@index([smartPageBlockId, day])
  @@index([smartPageId, visitorHash])
  @@index([smartCardId, day])
  @@index([smartCardActionId, day])
  @@index([smartCardId, visitorHash])
}

model AnalyticsVisitor {
  id                String   @id @default(cuid())
  workspaceId       String
  audienceContactId String?
  visitorHash       String   @db.VarChar(64)
  firstTouchSource  String?  @db.VarChar(253)
  firstTouchMedium  String?  @db.VarChar(120)
  firstTouchChannel String?  @db.VarChar(40)
  firstTouchCampaign String? @db.VarChar(120)
  firstTouchAt      DateTime @default(now())
  lastTouchSource   String?  @db.VarChar(253)
  lastTouchMedium   String?  @db.VarChar(120)
  lastTouchChannel  String?  @db.VarChar(40)
  lastTouchCampaign String?  @db.VarChar(120)
  lastTouchAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  audienceContact   AudienceContact? @relation("AudienceContactVisitors", fields: [audienceContactId], references: [id], onDelete: SetNull)
  sessions          AnalyticsSession[]
  events            AnalyticsEvent[]
  conversions       AnalyticsConversion[]
  formSubmissions   SmartPageFormSubmission[]

  @@unique([workspaceId, visitorHash])
  @@index([workspaceId, lastSeenAt])
  @@index([audienceContactId])
}

model AnalyticsSession {
  id                 String   @id @default(cuid())
  workspaceId        String
  visitorId          String
  sessionHash        String   @db.VarChar(64)
  startedAt          DateTime @default(now())
  lastActivityAt     DateTime @default(now())
  landingPage        String?  @db.VarChar(2048)
  entryReferrer      String?  @db.VarChar(253)
  initialSource      String?  @db.VarChar(253)
  initialMedium      String?  @db.VarChar(120)
  initialChannel     String?  @db.VarChar(40)
  initialCampaign    String?  @db.VarChar(120)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitor            AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  events             AnalyticsEvent[]
  conversions        AnalyticsConversion[]
  formSubmissions    SmartPageFormSubmission[]

  @@index([workspaceId, sessionHash, lastActivityAt])
  @@index([visitorId, startedAt])
}

model AnalyticsGoal {
  id               String                  @id @default(cuid())
  workspaceId      String
  name             String                  @db.VarChar(120)
  description      String?                 @db.VarChar(500)
  goalType         AnalyticsGoalType
  status           AnalyticsGoalStatus     @default(ACTIVE)
  scopeType        AnalyticsGoalScopeType  @default(WORKSPACE)
  scopeId          String?                 @db.VarChar(255)
  eventName        String                  @db.VarChar(80)
  conditions       Json                    @default("{}")
  isPrimary        Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  primaryForCampaigns Campaign[]           @relation("CampaignPrimaryGoal")
  conversions      AnalyticsConversion[]
  completionEvents AnalyticsEvent[]        @relation("AnalyticsGoalCompletionEvents")

  @@unique([workspaceId, name])
  @@index([workspaceId, status, eventName])
  @@index([workspaceId, scopeType, scopeId])
}

model AnalyticsConversion {
  id                 String   @id @default(cuid())
  workspaceId        String
  goalId             String
  eventId            String
  visitorId          String?
  sessionId          String?
  campaignId         String?  @db.VarChar(255)
  campaignAssetId    String?  @db.VarChar(255)
  assetType          String?  @db.VarChar(40)
  assetId            String?  @db.VarChar(255)
  source             String?  @db.VarChar(253)
  medium             String?  @db.VarChar(120)
  channel            String?  @db.VarChar(40)
  firstTouchSource   String?  @db.VarChar(253)
  firstTouchMedium   String?  @db.VarChar(120)
  firstTouchChannel  String?  @db.VarChar(40)
  firstTouchCampaign String?  @db.VarChar(120)
  metadata           Json     @default("{}")
  occurredAt         DateTime @default(now())
  day                DateTime? @db.Date
  isBot              Boolean  @default(false)
  isTest             Boolean  @default(false)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal               AnalyticsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  event              AnalyticsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  visitor            AnalyticsVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  session            AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([goalId, eventId])
  @@index([workspaceId, occurredAt])
  @@index([goalId, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([workspaceId, source, occurredAt])
  @@index([workspaceId, campaignId, occurredAt])
  @@index([workspaceId, campaignAssetId, occurredAt])
  @@index([workspaceId, day])
}

model AnalyticsAggregate {
  id             String   @id @default(cuid())
  workspaceId    String
  bucketStart    DateTime
  granularity    String   @db.VarChar(8)
  eventName      String   @db.VarChar(80)
  dimension      String   @db.VarChar(20)
  dimensionValue String   @db.VarChar(255)
  isBot          Boolean  @default(false)
  count          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, bucketStart, granularity, eventName, dimension, dimensionValue, isBot])
  @@index([workspaceId, bucketStart, granularity, dimension])
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  plan          Plan          @default(free)
  onboarding    Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  subscriptions UserSubscription[]
  trial         UserTrial?
  links         ShortLink[]
  history       LinkHistory[]
  memberships   WorkspaceMember[]
  campaignsResponsible Campaign[]
  campaignApprovals CampaignApproval[]
  projectMemberships ProjectMember[]
  favorites Favorite[]
  recentResources RecentResource[]
  audienceContactNotes AudienceContactNote[]
  ownedSmartCards SmartCard[] @relation("SmartCardOwner")
  analyticsEvents AnalyticsEvent[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model SmartPage {
  id          String          @id @default(cuid())
  workspaceId String
  slug        String          @unique @db.VarChar(60)
  title       String          @db.VarChar(120)
  description String          @default("") @db.VarChar(500)
  avatarUrl   String?         @db.VarChar(4096)
  theme       Json            @default("{}")
  socialLinks Json            @default("[]")
  status      SmartPageStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  images      SmartPageImage[]
  blocks      SmartPageBlock[]
  forms       SmartPageForm[]
  formSubmissions SmartPageFormSubmission[]
  analyticsEvents AnalyticsEvent[]

  @@index([workspaceId, createdAt])
  @@index([status, publishedAt])
}

model SmartCard {
  id               String          @id @default(cuid())
  workspaceId      String
  ownerId          String
  campaignId       String?
  qrAssetId        String?         @unique
  slug             String          @unique @db.VarChar(60)
  firstName        String          @db.VarChar(80)
  lastName         String          @default("") @db.VarChar(80)
  headline         String          @default("") @db.VarChar(160)
  company          String          @default("") @db.VarChar(120)
  bio              String          @default("") @db.VarChar(500)
  avatarUrl        String?         @db.VarChar(4096)
  logoUrl          String?         @db.VarChar(4096)
  phone            String?         @db.VarChar(40)
  whatsapp         String?         @db.VarChar(40)
  email            String?         @db.VarChar(254)
  websiteUrl       String?         @db.VarChar(4096)
  location         String?         @db.VarChar(160)
  contactPoints    Json            @default("[]")
  socialLinks      Json            @default("[]")
  theme            Json            @default("{}")
  contactForm      Json            @default("{}")
  privacyPolicyUrl String?         @db.VarChar(4096)
  status           SmartCardStatus @default(draft)
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner            User            @relation("SmartCardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  campaign         Campaign?       @relation(fields: [campaignId, workspaceId], references: [id, workspaceId])
  qrAsset          QrAsset?        @relation("SmartCardQr", fields: [qrAssetId], references: [id], onDelete: SetNull)
  actions          SmartCardAction[]
  walletPasses     SmartCardWalletPass[]
  contactExchanges SmartCardContactExchange[]
  analyticsEvents  AnalyticsEvent[]

  @@index([workspaceId, status, updatedAt])
  @@index([ownerId, createdAt])
  @@index([campaignId])
}

model SmartCardWalletPass {
  id               String                    @id @default(cuid())
  workspaceId      String
  smartCardId      String
  provider         SmartCardWalletProvider
  status           SmartCardWalletPassStatus @default(pending_sync)
  serialNumber     String?                   @unique @db.VarChar(120)
  externalObjectId String?                   @unique @db.VarChar(255)
  issuedAt         DateTime?
  lastSyncedAt     DateTime?
  lastError        String?                   @db.VarChar(1000)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  smartCard        SmartCard                 @relation(fields: [smartCardId], references: [id], onDelete: Cascade)

  @@unique([smartCardId, provider])
  @@index([workspaceId, status, updatedAt])
  @@index([smartCardId, updatedAt])
}

model SmartCardAction {
  id             String              @id @default(cuid())
  smartCardId    String
  type           SmartCardActionType
  label          String              @db.VarChar(80)
  url            String              @db.VarChar(4096)
  position       Int
  visible        Boolean             @default(true)
  analyticsEnabled Boolean            @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  smartCard      SmartCard           @relation(fields: [smartCardId], references: [id], onDelete: Cascade)
  analyticsEvents AnalyticsEvent[]

  @@unique([smartCardId, position])
  @@index([smartCardId, position])
}

model AudienceContact {
  id          String                @id @default(cuid())
  workspaceId String
  firstName   String                @default("") @db.VarChar(80)
  lastName    String                @default("") @db.VarChar(80)
  email       String?               @db.VarChar(254)
  phone       String?               @db.VarChar(40)
  whatsapp    String?               @db.VarChar(40)
  company     String?               @db.VarChar(120)
  jobTitle    String?               @db.VarChar(160)
  city        String?               @db.VarChar(120)
  creationSource String              @default("unknown") @db.VarChar(40)
  firstSeenAt  DateTime              @default(now())
  lastSeenAt   DateTime              @default(now())
  audienceStatus AudienceContactLifecycle @default(new)
  engagementLevel AudienceEngagementLevel @default(low)
  conversionCount Int                @default(0)
  meaningfulInteractionCount Int     @default(0)
  firstSource String?               @db.VarChar(253)
  firstMedium String?               @db.VarChar(120)
  firstChannel String?              @db.VarChar(40)
  firstCampaign String?             @db.VarChar(120)
  lastSource  String?               @db.VarChar(253)
  lastMedium  String?               @db.VarChar(120)
  lastChannel String?               @db.VarChar(40)
  lastCampaign String?              @db.VarChar(120)
  customFields Json                 @default("{}")
  status      AudienceContactStatus @default(new_contact)
  temperature ContactTemperature    @default(cold)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  exchanges   SmartCardContactExchange[]
  formSubmissions SmartPageFormSubmission[]
  analyticsVisitors AnalyticsVisitor[] @relation("AudienceContactVisitors")
  events      AudienceContactEvent[]
  notes       AudienceContactNote[]
  tags        AudienceContactTag[]
  analyticsEvents AnalyticsEvent[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@index([workspaceId, firstCampaign])
  @@index([workspaceId, lastCampaign])
  @@index([workspaceId, firstSource])
  @@index([workspaceId, audienceStatus, lastSeenAt])
  @@index([workspaceId, engagementLevel, lastSeenAt])
  @@unique([id, workspaceId])
}

model SmartCardContactExchange {
  id           String           @id @default(cuid())
  workspaceId  String
  smartCardId  String
  contactId    String
  campaignId   String?
  source       String           @default("direct") @db.VarChar(80)
  sourceLabel  String?          @db.VarChar(120)
  intent       String?          @db.VarChar(160)
  context      Json             @default("{}")
  consentText  String           @db.VarChar(1000)
  consentedAt  DateTime         @default(now())
  capturedAt   DateTime         @default(now())
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  smartCard    SmartCard        @relation(fields: [smartCardId], references: [id], onDelete: Cascade)
  contact      AudienceContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign     Campaign?        @relation(fields: [campaignId, workspaceId], references: [id, workspaceId])

  @@index([workspaceId, capturedAt])
  @@index([smartCardId, capturedAt])
  @@index([contactId, capturedAt])
  @@index([campaignId, capturedAt])
}

model AudienceContactEvent {
  id          String          @id @default(cuid())
  workspaceId String
  contactId   String
  name        String          @db.VarChar(80)
  metadata    Json            @default("{}")
  occurredAt  DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     AudienceContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, occurredAt])
  @@index([workspaceId, occurredAt])
}

model AudienceContactTag {
  workspaceId String
  contactId   String
  tagId       String
  createdAt   DateTime        @default(now())
  contact     AudienceContact @relation(fields: [contactId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  tag         Tag             @relation(fields: [tagId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([workspaceId, tagId])
}

model AudienceContactNote {
  id           String          @id @default(cuid())
  workspaceId  String
  contactId    String
  authorUserId String
  content      String          @db.VarChar(1000)
  createdAt    DateTime        @default(now())
  contact      AudienceContact @relation(fields: [contactId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  author       User            @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactId, createdAt])
}

model AudienceSegment {
  id          String    @id @default(cuid())
  workspaceId String
  name        String    @db.VarChar(120)
  description String    @default("") @db.VarChar(500)
  rules       Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
}

model Product {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String        @db.VarChar(120)
  slug         String        @db.VarChar(140)
  description  String        @default("") @db.VarChar(5000)
  type         ProductType
  status       ProductStatus @default(draft)
  priceInCents Int
  currency     String        @default("BRL") @db.VarChar(3)
  images       Json          @default("[]")
  metadata     Json          @default("{}")
  visible      Boolean       @default(true)
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocks       SmartPageBlock[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, updatedAt])
}

model SmartPageBlock {
  id               String     @id @default(cuid())
  smartPageId      String
  type             String     @db.VarChar(40)
  position         Int
  settings         Json
  visible          Boolean    @default(true)
  analyticsEnabled Boolean    @default(true)
  linkId           String?
  productId        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  smartPage        SmartPage  @relation(fields: [smartPageId], references: [id], onDelete: Cascade)
  link             ShortLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  product          Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  form             SmartPageForm?
  analyticsEvents  AnalyticsEvent[]

  @@unique([smartPageId, position])
  @@index([smartPageId, position])
  @@index([linkId])
  @@index([productId])
}

model SmartPageForm {
  id               String              @id @default(cuid())
  workspaceId      String
  smartPageId      String
  smartPageBlockId String              @unique
  name             String              @db.VarChar(120)
  title            String              @db.VarChar(120)
  description      String              @default("") @db.VarChar(500)
  submitLabel      String              @default("Enviar") @db.VarChar(80)
  successMessage   String              @default("Obrigado! Recebemos seus dados.") @db.VarChar(500)
  privacyPolicyUrl String?             @db.VarChar(4096)
  status           SmartPageFormStatus @default(active)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
