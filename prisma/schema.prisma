generator client {
  provider = "prisma-client-js"
}


enum SmartPageStatus {
  draft
  published
}

enum SmartCardStatus {
  draft
  published
  archived
}

enum SmartCardActionType {
  website
  whatsapp
  email
  phone
  calendar
  smartPage
  custom
}

enum AudienceContactStatus {
  new_contact
  interested
  qualified
  customer
  not_interested
}

enum ContactTemperature {
  cold
  warm
  hot
}

enum ProductStatus {
  draft
  active
  archived
}

enum ProductType {
  physical
  digital
  course
  booking
  session
  mentorship
  coaching
  bundle
  event
  subscription
}

enum ProjectStatus {
  active
  archived
}

enum ProjectResourceType {
  shortLink
  smartPage
  campaign
  utmLink
  qrAsset
  whatsappLink
}

enum WorkspaceResourceType {
  project
  shortLink
  smartPage
  campaign
  utmLink
  qrAsset
  whatsappLink
}

enum WhatsappLinkStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CollectionKind {
  manual
  smart
}

enum ProjectMemberRole {
  owner
  editor
  viewer
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalyticsEvent {
  id               String          @id @default(cuid())
  name             String
  occurredAt       DateTime        @default(now())
  metadata         Json
  workspaceId      String?
  smartPageId      String?
  smartPageBlockId String?
  smartCardId      String?
  smartCardActionId String?
  day              DateTime?       @db.Date
  visitorHash      String?         @db.VarChar(64)
  referrer         String?         @db.VarChar(253)
  device           String?         @db.VarChar(20)
  workspace        Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  smartPage        SmartPage?      @relation(fields: [smartPageId], references: [id], onDelete: Cascade)
  smartPageBlock   SmartPageBlock? @relation(fields: [smartPageBlockId], references: [id], onDelete: Cascade)
  smartCard        SmartCard?      @relation(fields: [smartCardId], references: [id], onDelete: Cascade)
  smartCardAction  SmartCardAction? @relation(fields: [smartCardActionId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt])
  @@index([smartPageId, day])
  @@index([smartPageBlockId, day])
  @@index([smartPageId, visitorHash])
  @@index([smartCardId, day])
  @@index([smartCardActionId, day])
  @@index([smartCardId, visitorHash])
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  onboarding    Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  links         ShortLink[]
  history       LinkHistory[]
  memberships   WorkspaceMember[]
  campaignsResponsible Campaign[]
  campaignApprovals CampaignApproval[]
  projectMemberships ProjectMember[]
  favorites Favorite[]
  recentResources RecentResource[]
  ownedSmartCards SmartCard[] @relation("SmartCardOwner")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model SmartPage {
  id          String          @id @default(cuid())
  workspaceId String
  slug        String          @unique @db.VarChar(60)
  title       String          @db.VarChar(120)
  description String          @default("") @db.VarChar(500)
  avatarUrl   String?         @db.VarChar(4096)
  theme       Json            @default("{}")
  socialLinks Json            @default("[]")
  status      SmartPageStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  images      SmartPageImage[]
  blocks      SmartPageBlock[]
  analyticsEvents AnalyticsEvent[]

  @@index([workspaceId, createdAt])
  @@index([status, publishedAt])
}

model SmartCard {
  id               String          @id @default(cuid())
  workspaceId      String
  ownerId          String
  campaignId       String?
  qrAssetId        String?         @unique
  slug             String          @unique @db.VarChar(60)
  firstName        String          @db.VarChar(80)
  lastName         String          @default("") @db.VarChar(80)
  headline         String          @default("") @db.VarChar(160)
  company          String          @default("") @db.VarChar(120)
  bio              String          @default("") @db.VarChar(500)
  avatarUrl        String?         @db.VarChar(4096)
  logoUrl          String?         @db.VarChar(4096)
  phone            String?         @db.VarChar(40)
  whatsapp         String?         @db.VarChar(40)
  email            String?         @db.VarChar(254)
  websiteUrl       String?         @db.VarChar(4096)
  location         String?         @db.VarChar(160)
  theme            Json            @default("{}")
  contactForm      Json            @default("{}")
  privacyPolicyUrl String?         @db.VarChar(4096)
  status           SmartCardStatus @default(draft)
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner            User            @relation("SmartCardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  campaign         Campaign?       @relation(fields: [campaignId, workspaceId], references: [id, workspaceId])
  qrAsset          QrAsset?        @relation("SmartCardQr", fields: [qrAssetId], references: [id], onDelete: SetNull)
  actions          SmartCardAction[]
  contactExchanges SmartCardContactExchange[]
  analyticsEvents  AnalyticsEvent[]

  @@index([workspaceId, status, updatedAt])
  @@index([ownerId, createdAt])
  @@index([campaignId])
}

model SmartCardAction {
  id             String              @id @default(cuid())
  smartCardId    String
  type           SmartCardActionType
  label          String              @db.VarChar(80)
  url            String              @db.VarChar(4096)
  position       Int
  visible        Boolean             @default(true)
  analyticsEnabled Boolean            @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  smartCard      SmartCard           @relation(fields: [smartCardId], references: [id], onDelete: Cascade)
  analyticsEvents AnalyticsEvent[]

  @@unique([smartCardId, position])
  @@index([smartCardId, position])
}

model AudienceContact {
  id          String                @id @default(cuid())
  workspaceId String
  firstName   String                @default("") @db.VarChar(80)
  lastName    String                @default("") @db.VarChar(80)
  email       String?               @db.VarChar(254)
  phone       String?               @db.VarChar(40)
  whatsapp    String?               @db.VarChar(40)
  company     String?               @db.VarChar(120)
  jobTitle    String?               @db.VarChar(160)
  city        String?               @db.VarChar(120)
  customFields Json                 @default("{}")
  status      AudienceContactStatus @default(new_contact)
  temperature ContactTemperature    @default(cold)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  exchanges   SmartCardContactExchange[]
  events      AudienceContactEvent[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
}

model SmartCardContactExchange {
  id           String           @id @default(cuid())
  workspaceId  String
  smartCardId  String
  contactId    String
  campaignId   String?
  source       String           @default("direct") @db.VarChar(80)
  sourceLabel  String?          @db.VarChar(120)
  intent       String?          @db.VarChar(160)
  context      Json             @default("{}")
  consentText  String           @db.VarChar(1000)
  consentedAt  DateTime         @default(now())
  capturedAt   DateTime         @default(now())
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  smartCard    SmartCard        @relation(fields: [smartCardId], references: [id], onDelete: Cascade)
  contact      AudienceContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign     Campaign?        @relation(fields: [campaignId, workspaceId], references: [id, workspaceId])

  @@index([workspaceId, capturedAt])
  @@index([smartCardId, capturedAt])
  @@index([contactId, capturedAt])
  @@index([campaignId, capturedAt])
}

model AudienceContactEvent {
  id          String          @id @default(cuid())
  workspaceId String
  contactId   String
  name        String          @db.VarChar(80)
  metadata    Json            @default("{}")
  occurredAt  DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     AudienceContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, occurredAt])
  @@index([workspaceId, occurredAt])
}

model Product {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String        @db.VarChar(120)
  slug         String        @db.VarChar(140)
  description  String        @default("") @db.VarChar(5000)
  type         ProductType
  status       ProductStatus @default(draft)
  priceInCents Int
  currency     String        @default("BRL") @db.VarChar(3)
  images       Json          @default("[]")
  metadata     Json          @default("{}")
  visible      Boolean       @default(true)
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocks       SmartPageBlock[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, updatedAt])
}

model SmartPageBlock {
  id               String     @id @default(cuid())
  smartPageId      String
  type             String     @db.VarChar(40)
  position         Int
  settings         Json
  visible          Boolean    @default(true)
  analyticsEnabled Boolean    @default(true)
  linkId           String?
  productId        String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  smartPage        SmartPage  @relation(fields: [smartPageId], references: [id], onDelete: Cascade)
  link             ShortLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  product          Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  analyticsEvents  AnalyticsEvent[]

  @@unique([smartPageId, position])
  @@index([smartPageId, position])
  @@index([linkId])
  @@index([productId])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model ShortLink {
  id             String      @id @default(cuid())
  slug           String
  domainKey      String      @default("platform")
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expiresAt      DateTime?
  tags           String[]    @default([])
  folderId       String?
  folder         LinkFolder? @relation(fields: [folderId, workspaceId], references: [id, workspaceId])
  campaignId     String?
  campaign       Campaign?   @relation(fields: [campaignId, workspaceId], references: [id, workspaceId])
  distribution   String      @default("digital")
  qr             QrAsset?
  destinationUrl String      @db.VarChar(4096)
  title          String      @default("") @db.VarChar(120)
  description    String      @default("") @db.VarChar(500)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks         LinkClick[]
  smartPageBlocks SmartPageBlock[]
  whatsappLink   WhatsappLink? @relation("WhatsappSmartLink")
  campaignAssets CampaignAsset[]

  @@unique([domainKey, slug])
  @@unique([id, workspaceId])

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
}

model LinkClick {
  id        String    @id @default(cuid())
  linkId    String
  link      ShortLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  day       DateTime  @db.Date
  referrer  String    @db.VarChar(253)
  device    String    @db.VarChar(20)

  @@index([linkId, createdAt])
  @@index([linkId, day])
}

model LinkHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalUrl String   @db.VarChar(4096)
  resultUrl   String   @db.VarChar(8192)
  kind        String   @db.VarChar(20)
  createdAt   DateTime @default(now())
  importKey   String?
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, importKey])
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

enum WorkspaceRole {
  owner
  admin
  editor
  viewer
}

enum Plan {
  free
  pro
  business
}

model Workspace {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  plan Plan @default(free)
  governance Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members WorkspaceMember[]
  clients Client[]
  campaigns Campaign[]
  campaignAssets CampaignAsset[]
  usage WorkspaceUsage[]
  audits AuditLog[]
  links ShortLink[]
  history LinkHistory[]
  templates UtmTemplate[]
  utmLinks UtmLink[]
  folders LinkFolder[]
  domains CustomDomain[]
  qrs QrAsset[]
  channels CampaignChannel[]
  checklistItems CampaignChecklist[]
  approvals CampaignApproval[]
  monitorChecks CampaignMonitorCheck[]
  incidents CampaignIncident[]
  deliveries NotificationDelivery[]
  smartPages SmartPage[]
  analyticsEvents AnalyticsEvent[]
  projects Project[]
  tags Tag[]
  collections Collection[]
  favorites Favorite[]
  recentResources RecentResource[]
  whatsappLinks WhatsappLink[]
  products Product[]
  smartCards SmartCard[]
  audienceContacts AudienceContact[]
  smartCardContactExchanges SmartCardContactExchange[]
  audienceContactEvents AudienceContactEvent[]
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  name        String        @db.VarChar(120)
  slug        String        @db.VarChar(140)
  description String        @default("") @db.VarChar(500)
  icon        String        @default("folder") @db.VarChar(40)
  color       String        @default("#285239") @db.VarChar(16)
  goal        String?       @db.VarChar(40)
  status      ProjectStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resources   ProjectResource[]
  members     ProjectMember[]
  collections Collection[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, status, updatedAt])
}

model ProjectResource {
  id           String              @id @default(cuid())
  workspaceId  String
  projectId    String
  resourceType ProjectResourceType
  resourceId   String
  createdAt    DateTime            @default(now())
  project      Project             @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([projectId, resourceType, resourceId])
  @@index([projectId, createdAt])
  @@index([workspaceId, resourceType, resourceId])
}

model ProjectMember {
  projectId  String
  userId     String
  role       ProjectMemberRole @default(viewer)
  createdAt  DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String   @db.VarChar(80)
  slug        String   @db.VarChar(100)
  color       String   @default("#285239") @db.VarChar(16)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resources   ResourceTag[]

  @@unique([workspaceId, slug])
  @@unique([id, workspaceId])
  @@index([workspaceId, archivedAt, name])
}

model ResourceTag {
  workspaceId  String
  tagId        String
  resourceType WorkspaceResourceType
  resourceId   String
  createdAt    DateTime              @default(now())
  tag          Tag                   @relation(fields: [tagId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([tagId, resourceType, resourceId])
  @@index([workspaceId, resourceType, resourceId])
}

model Favorite {
  workspaceId  String
  userId       String
  resourceType WorkspaceResourceType
  resourceId   String
  createdAt    DateTime              @default(now())
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId, resourceType, resourceId])
  @@index([workspaceId, userId, createdAt])
}

model RecentResource {
  workspaceId  String
  userId       String
  resourceType WorkspaceResourceType
  resourceId   String
  viewedAt     DateTime              @updatedAt
  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId, resourceType, resourceId])
  @@index([workspaceId, userId, viewedAt])
}

model Collection {
  id          String         @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String         @db.VarChar(120)
  description String         @default("") @db.VarChar(500)
  kind        CollectionKind @default(manual)
  rules       Json           @default("[]")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  resources   CollectionResource[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, projectId, name])
  @@index([workspaceId, projectId, updatedAt])
}

model CollectionResource {
  id           String                @id @default(cuid())
  workspaceId  String
  collectionId String
  resourceType WorkspaceResourceType
  resourceId   String
  position     Int
  createdAt    DateTime              @default(now())
  collection   Collection            @relation(fields: [collectionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([collectionId, resourceType, resourceId])
  @@unique([collectionId, position])
  @@index([workspaceId, resourceType, resourceId])
  @@index([collectionId, position])
}

model WorkspaceMember {
  workspaceId String
  userId String
  role WorkspaceRole @default(viewer)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([workspaceId, userId])
  @@index([userId])
}

model WorkspaceUsage {
  workspaceId String
  resource String
  count Int @default(0)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([workspaceId, resource])
}

model AuditLog {
  id String @id @default(cuid())
  workspaceId String
  actorId String
  action String
  entityId String
  details Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model Client {
  id String @id @default(cuid())
  workspaceId String
  name String @db.VarChar(120)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  utmLinks UtmLink[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}

model Campaign {
  id String @id @default(cuid())
  workspaceId String
  name String @db.VarChar(120)
  description String? @db.VarChar(2000)
  clientId String?
  responsibleId String?
  objective String? @db.VarChar(1000)
  objectiveType String? @db.VarChar(40)
  primaryDestinationType String? @db.VarChar(40)
  primaryDestinationId String? @db.VarChar(255)
  primaryDestinationUrl String? @db.VarChar(4096)
  startDate DateTime?
  endDate DateTime?
  status String @default("draft") @db.VarChar(20)
  approvalStatus String? @db.VarChar(20)
  approvedAt DateTime?
  approvedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId, workspaceId], references: [id, workspaceId])
  responsible User? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  utmLinks UtmLink[]
  shortLinks ShortLink[]
  qrs QrAsset[]
  channels CampaignChannel[]
  assets CampaignAsset[]
  checklistItems CampaignChecklist[]
  monitoringChecks CampaignMonitorCheck[]
  incidents CampaignIncident[]
  approvals CampaignApproval[]
  whatsappLinks WhatsappLink[]
  smartCards SmartCard[]
  smartCardContactExchanges SmartCardContactExchange[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([responsibleId])
}

model CampaignChannel {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  name String @db.VarChar(120)
  type String @db.VarChar(40)
  utmSource String? @db.VarChar(120)
  utmMedium String? @db.VarChar(120)
  utmCampaign String? @db.VarChar(120)
  utmTerm String? @db.VarChar(120)
  utmContent String? @db.VarChar(120)
  destinationUrl String @db.VarChar(4096)
  shortLinkId String?
  qrId String?
  templateId String?
  monitorEnabled Boolean @default(false)
  monitorFrequencyMinutes Int @default(60)
  monitorPaused Boolean @default(false)
  alternativeDestinationUrl String? @db.VarChar(4096)
  autoRedirectOnIncident Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assets CampaignAsset[]
  monitorChecks CampaignMonitorCheck[]
  incidents CampaignIncident[]
  @@unique([id, workspaceId])
  @@index([workspaceId, campaignId])
  @@index([campaignId])
}

model CampaignAsset {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  channelId String
  name String @db.VarChar(120)
  assetType String @db.VarChar(80)
  destinationType String @db.VarChar(40)
  destinationId String? @db.VarChar(255)
  destinationUrl String? @db.VarChar(4096)
  linkId String?
  qrId String?
  whatsappLinkId String?
  status String @default("active") @db.VarChar(20)
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel CampaignChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  link ShortLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  qr QrAsset? @relation(fields: [qrId], references: [id], onDelete: SetNull)
  whatsappLink WhatsappLink? @relation(fields: [whatsappLinkId], references: [id], onDelete: SetNull)

  @@unique([id, workspaceId])
  @@index([workspaceId, campaignId])
  @@index([campaignId, channelId])
  @@index([linkId])
  @@index([qrId])
  @@index([whatsappLinkId])
}

model WhatsappLink {
  id             String             @id @default(cuid())
  workspaceId    String
  name           String             @db.VarChar(120)
  phoneNumber    String             @db.VarChar(15)
  message        String             @default("") @db.VarChar(4096)
  campaignId     String?
  smartLinkId    String?            @unique
  status         WhatsappLinkStatus @default(ACTIVE)
  trackingConfig Json               @default("{\"enabled\":true}")
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign       Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  smartLink      ShortLink?         @relation("WhatsappSmartLink", fields: [smartLinkId], references: [id], onDelete: SetNull)
  campaignAssets CampaignAsset[]

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, phoneNumber, campaignId])
  @@index([campaignId])
}

model CampaignChecklist {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  channelId String?
  category String @db.VarChar(60)
  label String @db.VarChar(200)
  status String @default("pending") @db.VarChar(20)
  severity String @default("warning") @db.VarChar(20)
  details String @db.VarChar(2000)
  checkedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([workspaceId, campaignId])
  @@index([campaignId, status])
}

model CampaignMonitorCheck {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  channelId String?
  url String @db.VarChar(4096)
  httpStatus Int?
  responseTimeMs Int?
  finalUrl String? @db.VarChar(4096)
  redirectChain Json
  connectionError String?
  certExpiresAt DateTime?
  certIssuer String? @db.VarChar(200)
  status String @default("unknown") @db.VarChar(20)
  checkedAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel CampaignChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([workspaceId, checkedAt])
  @@index([campaignId, checkedAt])
  @@index([channelId, checkedAt])
}

model CampaignIncident {
  id String @id @default(cuid())
  workspaceId String
  campaignId String
  channelId String?
  code String @db.VarChar(80)
  message String @db.VarChar(500)
  status String @default("open") @db.VarChar(20)
  severity String @default("warning") @db.VarChar(20)
  confirmed Boolean @default(false)
  dedupeKey String @db.VarChar(200)
  cooldownUntil DateTime?
  recoveredAt DateTime?
  metadata Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel CampaignChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  @@unique([id, workspaceId])
  @@index([workspaceId, dedupeKey, createdAt])
  @@index([campaignId, status])
  @@index([channelId, status])
}

model CampaignApproval {
