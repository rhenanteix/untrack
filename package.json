{
  "name": "arrume-meu-link",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:migrate": "node scripts/prisma-migrate.mjs migrate dev",
    "prisma:deploy": "node scripts/prisma-migrate.mjs migrate deploy",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "setup:local": "node scripts/setup-local.mjs && npm run db:up && npm run prisma:generate && npm run prisma:deploy",
    "db:stop": "docker compose --env-file .env.local stop db",
    "predev": "npm run prisma:generate",
    "pretest:e2e": "npm run prisma:generate"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.6",
    "@prisma/client": "6.12.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.6",
    "csv-parse": "^7.0.3",
    "ipaddr.js": "^2.5.0",
    "jsqr": "^1.4.0",
    "next": "16.3.7",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5",
    "tldts": "^7.4.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prisma": "6.12.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
