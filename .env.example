# `npm run setup:local` generates .env.local with random secrets for Docker.
POSTGRES_PASSWORD="CHANGE_ME"
DATABASE_URL="postgresql://arrume:CHANGE_ME@localhost:55432/arrume_meu_link"
TEST_DATABASE_URL="postgresql://arrume:CHANGE_ME@localhost:55432/arrume_meu_link_test"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="CHANGE_ME"

# Analytics: "none" (default) | "prisma". "true" logs to the server console.
ANALYTICS_PERSISTENCE="none"
ANALYTICS_CONSOLE="false"

RATE_LIMIT_REQUESTS="100"
RATE_LIMIT_WINDOW="3600"

# Required in production: without Upstash the API answers 503 by design.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Smart Card Wallet (server-only; never prefix these variables with NEXT_PUBLIC_).
# Certificates and private keys must be Base64-encoded PEM contents, not file paths.
# Use SMART_CARD_WALLET_MODE="test" until Apple and Google production credentials are approved.
SMART_CARD_WALLET_MODE="test"

# Apple Wallet generic passes
APPLE_WALLET_PASS_TYPE_IDENTIFIER=""
APPLE_WALLET_TEAM_IDENTIFIER=""
APPLE_WALLET_ORGANIZATION_NAME=""
APPLE_WALLET_SIGNER_CERTIFICATE_BASE64=""
APPLE_WALLET_SIGNER_KEY_BASE64=""
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=""
APPLE_WALLET_WWDR_CERTIFICATE_BASE64=""

# Google Wallet generic passes
GOOGLE_WALLET_PROJECT_ID=""
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64=""
